{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MSVC: build active file",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "\"${workspaceFolder}\\.vscode\\msvc_build.bat\" \"${file}\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "C/C++: cl.exe build active file",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "\"${workspaceFolder}\\.vscode\\msvc_build.bat\" \"${file}\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "build KSE Simulator",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "\"${workspaceFolder}\\msvc_build.bat\" \"${workspaceFolder}\\22i-2327_A_Project.cpp\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$msCompile"]
    }
  ]
}
